{
  "name": "dsh-screen-beyond",
  "version": "0.5.8",
  "type": "module",
  "description": "屏幕彼端 · 住在屏幕另一端的 AI 小伙伴：人设卡、记忆与日记、生活作息、地图/2D/3D 舞台、聊天界面，以及她自己的虚拟屏幕和安卓手机。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "runtime",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "examples",
    "scripts",
    "start-pure-chat.cmd",
    "start-pure-chat.sh"
  ],
  "scripts": {
    "start": "node runtime/server.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ljx200719/dsh-screen-beyond.git"
  },
  "homepage": "https://github.com/ljx200719/dsh-screen-beyond#readme",
  "bugs": {
    "url": "https://github.com/ljx200719/dsh-screen-beyond/issues"
  }
}
