{
  "name": "dsh-screen-beyond",
  "version": "0.7.21",
  "type": "module",
  "description": "住在屏幕彼端的ta：人设卡、记忆与日记、生活作息、地图/2D/3D 舞台、聊天界面，以及她自己的虚拟屏幕和安卓手机。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "runtime",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "examples",
    "scripts",
    "start-pure-chat.cmd",
    "start-pure-chat.sh",
    "docs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node runtime/server.mjs",
    "check": "node --check runtime/server.mjs && node --check runtime/vm-chat.mjs && node --check runtime/sync.mjs && node --check runtime/memory.mjs && node --check runtime/data-store.mjs && node --check lib/index.js && node --check lib/client.js",
    "lint": "eslint runtime lib scripts",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ljx200719/dsh-screen-beyond.git"
  },
  "homepage": "https://github.com/ljx200719/dsh-screen-beyond#readme",
  "bugs": {
    "url": "https://github.com/ljx200719/dsh-screen-beyond/issues"
  }
}