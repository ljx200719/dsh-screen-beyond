{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-screen-beyond.local/schema/models.json",
  "title": "屏幕彼端 · 数据模型（冻结契约 apiVersion=2）",
  "description": "字段以 runtime/server.mjs、runtime/memory.mjs、runtime/sync.mjs、runtime/data-store.mjs 的实际实现为准（源码核对日 2026-11-14，运行时版本 0.7.23）。这是「简化 draft-07」：只描述字段名/类型/必填/含义，不做严格校验；服务端本身也不校验全部字段（多处是 clamp 或原样合并）。运行实例的实测/未实测状态见 docs/API-CONTRACT.md §12。",
  "x-api-version": 2,
  "x-runtime-version": "0.7.23",
  "x-source": "runtime/server.mjs, runtime/memory.mjs, runtime/sync.mjs, runtime/data-store.mjs",
  "x-frozen-at": "2026-11-14",
  "definitions": {
    "apiError": {
      "title": "错误响应 {ok:false,error}",
      "description": "所有 JSON 端点的失败响应约定。除 403 forbidden host/site/origin 与部分图片/SSE 端点是 text/plain 外，失败都用这个结构。业务性拒绝有时用 HTTP 200 + ok:false（见 docs/API-CONTRACT.md §4.3）。",
      "type": "object",
      "properties": {
        "ok": { "const": false, "description": "恒为 false" },
        "error": { "type": "string", "description": "中文或英文错误说明（不要按文本做分支，按 HTTP 状态码和 ok 判断）" },
        "hint": { "type": "string", "description": "可选操作提示（如旧网页 410）" },
        "entity": { "type": "string", "description": "409 版本冲突时：冲突实体名" },
        "id": { "type": "string", "description": "409 版本冲突时：实体 id" },
        "expectedRev": { "type": "integer", "description": "409 版本冲突时：客户端提交的版本" },
        "currentRev": { "type": "integer", "description": "409 版本冲突时：服务端当前版本" }
      },
      "required": ["ok", "error"],
      "additionalProperties": true
    },
    "versionPayload": {
      "title": "GET /api/version 响应（v2 冻结入口）",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" },
        "apiVersion": { "type": "integer", "description": "契约版本。冻结版本为 2；破坏性改动才 +1" },
        "version": { "type": "string", "description": "运行时插件版本号（package.json version，可被 DSH_COMPANION_VERSION 覆盖）" },
        "minClient": { "type": "string", "description": "服务端建议的最低客户端版本（源码当前写死 '0.7.24'）" },
        "dataRoot": { "type": "string", "description": "本机数据根目录绝对路径（本地调试用；手机客户端不得依赖）" },
        "auth": {
          "type": "object",
          "description": "鉴权能力协商：mode=token 时所有 /api/*（/api/token 除外）都要带 token",
          "properties": {
            "mode": { "type": "string", "enum": ["token", "loopback"] },
            "tokenEndpoint": { "type": "string" },
            "header": { "type": "string", "description": "header 名：x-companion-token" },
            "cookie": { "type": "string", "description": "cookie 名：companion_token" },
            "allowedOrigins": { "type": "array", "items": { "type": "string" } }
          }
        },
        "features": {
          "type": "object",
          "description": "能力开关（源码当前固定 true/false；legacyWeb 是运行时计算结果）。客户端必须按 feature 判断，不要按版本号猜能力",
          "properties": {
            "chat": { "type": "boolean" },
            "stream": { "type": "boolean" },
            "stage2d": { "type": "boolean" },
            "stage3d": { "type": "boolean" },
            "mapView": { "type": "boolean" },
            "mapEdit": { "type": "boolean" },
            "settings": { "type": "boolean" },
            "screen": { "type": "boolean" },
            "pet": { "type": "boolean" },
            "vmChat": { "type": "boolean" },
            "memory": { "type": "boolean" },
            "diary": { "type": "boolean" },
            "backup": { "type": "boolean" },
            "sync": { "type": "boolean" },
            "image": { "type": "boolean" },
            "weatherFx": { "type": "boolean" },
            "legacyWeb": { "type": "boolean" }
          }
        },
        "schema": {
          "type": "object",
          "description": "契约文档的相对路径（相对于插件仓库根）",
          "properties": {
            "contract": { "type": "string" },
            "apiIndex": { "type": "string" },
            "models": { "type": "string" }
          }
        },
        "endpoints": {
          "type": "object",
          "description": "常用端点快捷入口",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["ok", "apiVersion", "version", "features", "schema"]
    },
    "tokenStats": {
      "title": "tokens（钱包/用量摘要）",
      "description": "出现在 /api/status、/api/pet/status、/api/balance-alert 等响应里，由 tokenStats() 生成。",
      "type": "object",
      "properties": {
        "remainingTokens": { "type": "integer", "description": "tokenBudget - 累计已用（不小于 0）" },
        "usedTokens": { "type": "integer" },
        "dailyUsed": { "type": "integer", "description": "今日已用；跨天为 0" },
        "tokenBudget": { "type": "integer" },
        "moneyType": { "type": "string", "enum": ["virtual", "token"] },
        "tokenMode": { "type": "boolean" },
        "spendable": { "type": "integer", "description": "她自己的可用零花钱（虚拟钱包余额取整）" },
        "balance": { "type": "number" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "deepseekBalance": {
          "type": ["object", "null"],
          "description": "真实 DeepSeek 余额（后台刷新，可能为 null）：{ok,at,error,currency,total,todayRmb,note,granted,toppedUp,available}",
          "additionalProperties": true
        },
        "realRmb": { "type": ["number", "null"], "description": "真实人民币余额（未知为 null）" },
        "realBalanceKnown": { "type": "boolean" }
      }
    },
    "currentPlace": {
      "title": "location（当前位置，currentPlace()）",
      "type": "object",
      "properties": {
        "mapId": { "type": "string" },
        "mapName": { "type": "string" },
        "placeId": { "type": "string" },
        "name": { "type": "string", "description": "地点名（注意字段名是 name，不是 placeName）" },
        "icon": { "type": "string" },
        "desc": { "type": "string" },
        "feel": { "type": "string" },
        "since": { "type": "integer", "description": "到达/开始时间，ms epoch" },
        "minutes": { "type": "integer", "description": "已停留分钟（行程中为 0）" },
        "manual": { "type": "boolean" },
        "reason": { "type": "string" },
        "traveling": { "oneOf": [{ "$ref": "#/definitions/traveling" }, { "type": "null" }] },
        "intercity": { "oneOf": [{ "$ref": "#/definitions/intercity" }, { "type": "null" }] },
        "avatar": { "type": "string", "description": "头像地址；可能带 ?t=<mtime> 防缓存" }
      },
      "required": ["mapId", "placeId", "name", "since", "minutes"]
    },
    "traveling": {
      "title": "traveling（同地图内移动中）",
      "type": "object",
      "properties": {
        "fromId": { "type": "string" },
        "fromName": { "type": "string" },
        "toId": { "type": "string" },
        "toName": { "type": "string" },
        "mode": { "type": "string", "enum": ["walk", "bike", "bus", "metro", "car", "coach", "rail", "plane"] },
        "modeLabel": { "type": "string" },
        "modeIcon": { "type": "string" },
        "distanceMeters": { "type": "integer" },
        "durationMs": { "type": "integer" },
        "startedAt": { "type": "integer" },
        "progress": { "type": "number", "description": "0..1" },
        "etaSec": { "type": "integer" },
        "path": { "type": "array", "items": { "type": "array", "items": { "type": "number" } }, "description": "归一化坐标折线 [[x,y],…]" }
      }
    },
    "intercity": {
      "title": "intercity（跨地图长途）",
      "type": "object",
      "properties": {
        "mode": { "type": "string" },
        "modeLabel": { "type": "string" },
        "modeIcon": { "type": "string" },
        "fromMapName": { "type": "string" },
        "toMapName": { "type": "string" },
        "distanceKm": { "type": "number" },
        "progress": { "type": "number" },
        "etaSec": { "type": "integer" },
        "durationMs": { "type": "integer" },
        "startedAt": { "type": "integer" }
      }
    },
    "characterSummary": {
      "title": "角色摘要（GET /api/characters 列表项 / 切换结果）",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "角色 id，正则 ^[A-Za-z0-9_-]{1,40}$" },
        "name": { "type": "string" },
        "avatar": { "type": "string", "description": "/avatar.png?c=<id>（有自定义头像）或 /default-avatar.png" }
      },
      "required": ["id", "name", "avatar"]
    },
    "characterMeta": {
      "title": "角色元数据（meta.json / GET /api/persona.meta）",
      "description": "META_DEFAULT 之上的任意覆盖；服务端只保证 name/traits/examples 等字段类型宽松。avatar 由 avatar.bin 决定，写入时会被删掉。",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "角色名（默认「小鲸」）" },
        "userCall": { "type": "string", "description": "角色怎么称呼用户（默认「你」）" },
        "relation": { "type": "string", "description": "关系设定" },
        "avatar": { "type": "string", "description": "只读：/avatar.png?t=… 或 /default-avatar.png" },
        "examples": { "type": "array", "items": { "type": "string" }, "description": "说话风格示例（注入提示词）" },
        "traits": { "type": "object", "description": "性格开关：{话多:6, 主动:6, 撒娇:7, …} 数值越大越强", "additionalProperties": { "type": "number" } },
        "model": {
          "type": "object",
          "description": "角色 3D/立绘模型（本次桌面版不渲染 3D，但字段保留）",
          "properties": {
            "type": { "type": "string" },
            "url": { "type": "string" },
            "scale": { "type": "number" }
          }
        },
        "sprite": { "type": "string", "description": "桌宠/舞台用的立绘路径，默认 /pet-sprite/idle.png" },
        "chibi": { "type": ["string", "null"], "description": "Q 版模型路径（可为 null）" },
        "age": { "type": ["number", "null"], "description": "年龄；null=未知。影响出行权限（<18 夜间外出要确认、不能开车）" },
        "license": { "type": "boolean", "description": "是否有驾照（且成年才算有效）" },
        "travelPref": { "type": "string", "description": "默认出行方式偏好，默认 auto" }
      },
      "required": ["name"]
    },
    "personaPayload": {
      "title": "GET/POST /api/persona 响应",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean", "description": "GET 响应没有 ok 字段；POST 有" },
        "meta": { "$ref": "#/definitions/characterMeta" },
        "body": { "type": "string", "description": "人设正文（persona.md 全文 Markdown）" },
        "rev": { "oneOf": [{ "$ref": "#/definitions/revisionRecord" }, { "type": "null" }], "description": "实体 character 的版本（可能为 null）" },
        "personaRev": { "oneOf": [{ "$ref": "#/definitions/revisionRecord" }, { "type": "null" }], "description": "实体 persona 的版本（可能为 null）" }
      },
      "required": ["meta", "body"]
    },
    "message": {
      "title": "聊天消息（messages.json / GET /api/events）",
      "description": "role 只有 user/her 与历史遗留 system。id 在同一角色内单调递增；跨端去重用 uid。GET /api/events 会过滤 hidden:true。",
      "type": "object",
      "properties": {
        "id": { "type": "integer", "description": "角色内自增 id，也是 /api/events?since= 的游标" },
        "uid": { "type": "string", "description": "稳定 UUID（历史数据加载时补齐），跨端去重/同步用" },
        "role": { "type": "string", "enum": ["user", "her", "system"] },
        "text": { "type": "string", "description": "正文；图片消息的占位文本可能是「[图片]」" },
        "at": { "type": "integer", "description": "写入时间 ms epoch" },
        "image": { "type": "string", "description": "可选图片地址：用户上传为 /models/…，AI 生成为 /images/…" },
        "hidden": { "type": "boolean", "description": "可选；隐藏消息不进 /api/events（桌宠 look 等内部提示用）" }
      },
      "required": ["id", "uid", "role", "text", "at"]
    },
    "memoryFact": {
      "title": "记忆事实卡（facts.json）",
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "uid": { "type": "string" },
        "text": { "type": "string", "description": "事实正文，最长 90 字（maxFactChars）" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "最多 6 个，每个 ≤12 字" },
        "importance": { "type": "number", "description": "0..1，导入时指定，默认 0.5" },
        "strength": { "type": "number", "description": "0..1 记忆强度，按半衰期衰减；pinned 恒为 1" },
        "createdAt": { "type": "integer" },
        "lastSeenAt": { "type": "integer" },
        "hitCount": { "type": "integer" },
        "pinned": { "type": "boolean", "description": "核心记忆：不衰减、永远注入" },
        "archived": { "type": "boolean", "description": "强度低于 forgetThreshold 后归档：不注入，但保留可查" }
      },
      "required": ["id", "uid", "text", "tags", "importance", "strength", "createdAt", "lastSeenAt", "hitCount", "pinned", "archived"]
    },
    "memoryParams": {
      "title": "记忆参数（GET /api/memory.params，POST /api/memory/params）",
      "type": "object",
      "properties": {
        "halfLifeDays": { "type": "number", "description": "半衰期天数，默认 5，范围 0.5..365" },
        "forgetThreshold": { "type": "number", "description": "遗忘阈值，默认 0.12，范围 0.01..0.9" },
        "reinforceBoost": { "type": "number", "description": "强化增量，默认 0.22，范围 0..1" },
        "maxInjected": { "type": "integer", "description": "每次注入上限，默认 8，范围 0..100" },
        "coreStrength": { "type": "number", "description": "核心记忆强度阈值，默认 0.85，范围 0.1..1" },
        "maxFactChars": { "type": "integer", "description": "单条事实最大字数，默认 90" },
        "maxPromptChars": { "type": "integer", "description": "注入提示词总字数上限，默认 900，范围 100..5000" }
      }
    },
    "memoryStats": {
      "title": "记忆统计（MEM.stats()）",
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "live": { "type": "integer" },
        "archived": { "type": "integer" },
        "core": { "type": "integer", "description": "pinned 或 strength>=coreStrength" },
        "strongest": { "type": "array", "items": { "type": "object", "properties": { "text": { "type": "string" }, "strength": { "type": "number" } } }, "description": "最强 5 条" }
      }
    },
    "memoryPayload": {
      "title": "GET /api/memory 响应",
      "type": "object",
      "properties": {
        "stats": { "$ref": "#/definitions/memoryStats" },
        "params": { "$ref": "#/definitions/memoryParams" },
        "facts": { "type": "array", "items": { "$ref": "#/definitions/memoryFact" }, "description": "未归档" },
        "archived": { "type": "array", "items": { "$ref": "#/definitions/memoryFact" } },
        "diaryDates": { "type": "array", "items": { "type": "string", "description": "YYYY-MM-DD" } },
        "rev": { "oneOf": [{ "$ref": "#/definitions/revisionRecord" }, { "type": "null" }], "description": "实体 memory-facts:<角色 id> 的版本，可作 expectedRev" }
      }
    },
    "lifeScheduleItem": {
      "title": "作息表项（life.schedules[]）",
      "type": "object",
      "properties": {
        "time": { "type": "string", "description": "如 '07:30' 或 '18:30 - 19:30'" },
        "label": { "type": "string", "description": "如 起床/上学/午饭" },
        "days": { "type": "array", "items": { "type": "integer" }, "description": "可选，周几生效；缺省每天" },
        "place": { "type": "string", "description": "可选，地点 id；缺省由 label 猜" }
      },
      "required": ["time", "label"]
    },
    "lifeActivityItem": {
      "title": "活动项（life.activities[]）",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "活动名，如 刷 B 站 / 看视频" },
        "window": { "type": "string", "description": "生效时间段，如 '22:00-01:30'；空=全天" },
        "weight": { "type": "number", "description": "权重" },
        "minMin": { "type": "number" },
        "maxMin": { "type": "number" }
      },
      "required": ["name"]
    },
    "lifeConfig": {
      "title": "生活配置（life.json / GET /api/life）",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "生活模拟总开关" },
        "heartbeatMin": { "type": "number", "description": "心跳间隔（分钟）" },
        "proactive": { "type": "number", "description": "主动消息强度（旧字段）" },
        "proactiveEnabled": { "type": "boolean", "description": "是否允许她主动发消息" },
        "proactiveMinMin": { "type": "number", "description": "主动消息最小间隔（分钟，默认 30）" },
        "proactiveMaxMin": { "type": "number", "description": "主动消息最大间隔（分钟，默认 90）" },
        "quietStart": { "type": "number", "description": "免打扰开始小时（0..23）" },
        "quietEnd": { "type": "number", "description": "免打扰结束小时（0..23）" },
        "diaryHour": { "type": "number", "description": "自动写日记的小时（默认 22）" },
        "diaryAuto": { "type": "boolean" },
        "smartLife": { "type": "boolean", "description": "AI 决策生活（否则本地随机）" },
        "schedules": { "type": "array", "items": { "$ref": "#/definitions/lifeScheduleItem" } },
        "activities": { "type": "array", "items": { "$ref": "#/definitions/lifeActivityItem" } }
      },
      "required": ["enabled", "schedules", "activities"]
    },
    "lifeSimSettings": {
      "title": "生活模拟设置（GET/POST /api/life/settings，lifeSimCfg()）",
      "description": "POST 的数值会被 clamp：minEventGapMin 5..720、maxDaily 0..100、quietStart/End 0..23、photoChance 0..1。",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minEventGapMin": { "type": "number", "description": "两件事最小间隔，默认 90" },
        "maxDaily": { "type": "number", "description": "每日事件上限，默认 8" },
        "quietStart": { "type": "number", "description": "默认 23" },
        "quietEnd": { "type": "number", "description": "默认 8" },
        "photoChance": { "type": "number", "description": "主动消息附图概率，默认 0.25" }
      }
    },
    "lifeState": {
      "title": "生活状态（life-state.json / GET /api/life/state）",
      "description": "GET /api/life/states 会在每个 state 上额外加 name、avatar。",
      "type": "object",
      "properties": {
        "characterId": { "type": "string" },
        "mapId": { "type": "string" },
        "placeId": { "type": "string" },
        "placeName": { "type": "string" },
        "hotspotId": { "type": "string", "description": "热点 id（内置场景的热点只有 label，所以这里常是 label）" },
        "hotspotLabel": { "type": "string" },
        "behavior": { "type": "string", "enum": ["sleep", "read", "study", "eat", "coffee", "phone", "look", "idle"] },
        "behaviorLabel": { "type": "string", "description": "睡觉/看书/写作业/吃饭/喝咖啡/看手机/看看/发呆" },
        "position": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" } }, "description": "场景内归一化坐标 0..1" },
        "path": { "type": "array", "items": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } }, "description": "A* 走位折线" },
        "startedAt": { "type": "integer" },
        "endsAt": { "type": "integer", "description": "当前行为结束时间 ms epoch" },
        "energy": { "type": "number" },
        "mood": { "type": "string", "description": "默认「平静」" },
        "lastDecisionAt": { "type": "integer" },
        "lastEventAt": { "type": "integer" },
        "eventsDate": { "type": "string" },
        "eventsToday": { "type": "number" }
      },
      "required": ["characterId", "mapId", "placeId", "behavior", "position", "startedAt", "endsAt", "energy"]
    },
    "charState": {
      "title": "角色体力（state.json / loadCharState()）",
      "type": "object",
      "properties": {
        "energy": { "type": "integer", "description": "0..100，按时间/活动自动增减" }
      }
    },
    "economy": {
      "title": "经济配置（config.economy / GET /api/economy.economy）",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "经济系统总开关" },
