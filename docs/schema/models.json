            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "hit": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" } } },
              "prompt": { "type": "string" },
              "bubble": { "type": "string" }
            }
          }
        },
        "buttons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "action": { "type": "string" },
              "title": { "type": "string" },
              "icon": { "type": "string" }
            }
          }
        }
      }
    },
    "petStatus": {
      "title": "GET /api/pet/status 响应（petStatusPayload()）",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" },
        "running": { "type": "boolean" },
        "serverTime": { "type": "integer" },
        "character": { "$ref": "#/definitions/characterSummary" },
        "place": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "icon": { "type": "string" } } },
        "state": { "type": "string", "enum": ["stationary", "traveling", "intercity"] },
        "transport": { "type": "string" },
        "activity": { "type": "string" },
        "energy": { "type": "string", "description": "文字描述（精力很足…），不是数值" },
        "tokens": { "oneOf": [{ "$ref": "#/definitions/tokenStats" }, { "type": "null" }] },
        "weather": { "type": ["object", "null"], "properties": { "kind": { "type": "string" }, "label": { "type": "string" }, "icon": { "type": "string" } } },
        "lastHer": {
          "type": ["object", "null"],
          "properties": { "id": { "type": "integer" }, "text": { "type": "string" }, "at": { "type": "integer" } },
          "description": "她最后一条消息（没有则 null）"
        },
        "manifest": { "$ref": "#/definitions/petConfig" }
      },
      "required": ["ok", "running", "character"]
    },
    "vmChatSettings": {
      "title": "VM 聊天设置（GET/POST /api/vm-chat/settings）",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "默认 false" },
        "checkMessages": { "type": "boolean" },
        "autoStart": { "type": "boolean" },
        "idleShutdown": { "type": "boolean" },
        "checkIntervalMin": { "type": "number", "description": "2..1440，默认 15" },
        "targetContact": { "type": "string", "description": "最多 60 字" },
        "unreadScan": { "type": "boolean" },
        "watchdog": { "type": "boolean" },
        "sendImages": { "type": "boolean" },
        "lastUserText": { "type": "string", "description": "运行时附加字段（最近一次收到的文本）" },
        "lastCheckAt": { "type": "integer", "description": "运行时附加字段：上次检查时间 ms" }
      }
    },
    "vmChatStatus": {
      "title": "GET /api/vm-chat/status 响应",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" },
        "status": {
          "type": "object",
          "properties": {
            "running": { "type": "boolean", "description": "VM 是否在运行" },
            "apps": { "type": "array", "items": { "type": "object", "additionalProperties": true }, "description": "VM 内可用应用探测结果（id/name/categories/exec）" },
            "last": { "description": "最近一次检查结果（结构随 checkAndReply，可为 null）" }
          }
        }
      }
    },
    "backupItem": {
      "title": "备份文件（GET /api/backup/list.backups[]）",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "backup-YYYYMMDD-HHMMSS.zip" },
        "size": { "type": "integer", "description": "字节" },
        "at": { "type": "number", "description": "mtime ms epoch" }
      },
      "required": ["name", "size", "at"]
    },
    "screenSpaceStatus": {
      "title": "GET /api/screen/space/status 响应（5 秒缓存）",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" },
        "vm": { "type": "boolean", "description": "DSH-Space 虚拟机是否运行" },
        "http": { "type": "boolean", "description": "x11vnc + websockify + 6080 链路是否通" },
        "chain": { "type": ["object", "null"], "description": "VM 内链路探测原文 {x11vnc,websockify,listening_6080,…}" },
        "healing": { "type": "boolean", "description": "是否正在自动修复链路" },
        "url": { "type": "string", "description": "http://127.0.0.1:6081/vnc.html" }
      }
    },
    "routinePayload": {
      "title": "GET /api/routine 响应",
      "type": "object",
      "properties": {
        "routine": {
          "type": "object",
          "properties": {
            "bands": { "type": "array", "items": { "type": "object", "properties": { "start": { "type": "number" }, "end": { "type": "number" }, "allowed": { "type": "boolean" }, "weights": { "type": "object", "additionalProperties": { "type": "number" } } } } },
            "smart": { "type": "boolean" }
          }
        },
        "visits": { "type": "object", "description": "{placeId:{count,lastAt}}", "additionalProperties": { "type": "object", "properties": { "count": { "type": "integer" }, "lastAt": { "type": "integer" } } } },
        "places": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "icon": { "type": "string" } } } },
        "character": { "type": "string", "description": "当前角色名" }
      }
    }
  }
}
